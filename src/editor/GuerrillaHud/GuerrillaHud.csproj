<Project Sdk="Microsoft.NET.Sdk">

  <!-- GuerrillaHud.exe: makes Red Faction: Guerrilla's HUD loadable in Armageddon, for the
       guerrilla_hud mod, from your own copy of Guerrilla. Built into bin\editor\ by build.cmd. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GuerrillaHud</RootNamespace>
    <AssemblyName>GuerrillaHud</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RfaFormats\RfaFormats.csproj" />
  </ItemGroup>

</Project>
