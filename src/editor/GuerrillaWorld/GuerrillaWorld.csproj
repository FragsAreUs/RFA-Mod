<Project Sdk="Microsoft.NET.Sdk">

  <!-- GuerrillaWorld.exe: builds the world "rfg", Red Faction: Guerrilla's open world, from your own
       copy of Guerrilla, for the guerrilla_world mod. Built into bin\editor\ by build.cmd. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GuerrillaWorld</RootNamespace>
    <AssemblyName>GuerrillaWorld</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RfaFormats\RfaFormats.csproj" />
  </ItemGroup>

</Project>
