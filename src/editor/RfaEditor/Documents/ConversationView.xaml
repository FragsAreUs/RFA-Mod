<UserControl x:Class="RfaEditor.ConversationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A conversation (.ctdg_pc): who says which line, in order; its lines played from voices.vpp_pc on rfa_audio's engine -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="80" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="120" MinHeight="40" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,4">
            <Button x:Name="PlayAllButton" Content="Play conversation" Click="OnPlayAll" Style="{StaticResource PrimaryButton}" Margin="0,0,6,6"
                    ToolTip="Play every line in order, with the pauses (and overlaps) the file gives, from the picked line on (or the first)" />
            <Button x:Name="PlayLineButton" Content="Play line" Click="OnPlayLine" Margin="0,0,6,6" MinWidth="70"
                    ToolTip="Play only the picked line (Enter, or double-click it)" />
            <Button Content="Stop" Click="OnStop" Margin="0,0,14,6" MinWidth="70" ToolTip="Stop the lines playing" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource DimTextBrush}" TextWrapping="Wrap" Margin="4,0,0,6" />
        </WrapPanel>

        <TextBlock Grid.Row="1" Text="WHO SPEAKS" Style="{StaticResource SectionTitle}" Margin="0,4,0,4" />
        <ListView x:Name="PeopleList" Grid.Row="2" MaxHeight="160" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Persona" Width="160" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Lines" Width="50" DisplayMemberBinding="{Binding Lines}" />
                    <GridViewColumn Header="Voice bank" Width="420" DisplayMemberBinding="{Binding Bank}" />
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock Grid.Row="3" Text="LINES" Style="{StaticResource SectionTitle}" Margin="0,10,0,4" />
        <ListView x:Name="LineList" Grid.Row="4" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="Single"
                  SelectionChanged="OnLineChosen" MouseDoubleClick="OnLineDoubleClick" KeyDown="OnLineKey">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="" Width="26" DisplayMemberBinding="{Binding Playing}" />
                    <GridViewColumn Header="#" Width="34" DisplayMemberBinding="{Binding Number}" />
                    <GridViewColumn Header="Pause before" Width="90" DisplayMemberBinding="{Binding Pause}" />
                    <GridViewColumn Header="Speaker" Width="130" DisplayMemberBinding="{Binding Speaker}" />
                    <GridViewColumn Header="Line" Width="150" DisplayMemberBinding="{Binding LineName}" />
                    <GridViewColumn Header="Folder" Width="190" DisplayMemberBinding="{Binding Folder}" />
                    <GridViewColumn Header="In the game" Width="260" DisplayMemberBinding="{Binding State}" />
                </GridView>
            </ListView.View>
        </ListView>

        <GridSplitter Grid.Row="5" Height="6" HorizontalAlignment="Stretch" Background="Transparent" />
        <TextBox x:Name="DetailsBox" Grid.Row="6" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" />
    </Grid>
</UserControl>
