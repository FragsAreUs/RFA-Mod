<Project Sdk="Microsoft.NET.Sdk">

  <!-- The editor: a Windows desktop app (WPF). Built into bin\editor\ by build.cmd. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RfaEditor</RootNamespace>
    <AssemblyName>RfaEditor</AssemblyName>
    <!-- 64-bit: a level with its zones around needs more than a 32-bit program's 2 GB -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RfaFormats\RfaFormats.csproj" />
  </ItemGroup>

  <!-- The Direct3D view's shaders, as readable source, compiled when the editor starts -->
  <ItemGroup>
    <EmbeddedResource Include="Render\Shaders\*.hlsl" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D9" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

</Project>
