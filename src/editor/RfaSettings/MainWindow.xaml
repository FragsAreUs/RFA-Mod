<!--
    The settings window: the file's sections on the left (with how many you changed), a search box
    over every setting, the settings of the section picked (or every match) on the right, and Save.
    The rows are made in MainWindow.xaml.cs, from rfa_mods.ini's comments.
-->
<Window x:Class="RfaSettings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Settings · RFA-Mod" Width="1120" Height="820" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Search, and only what you changed -->
        <Border Grid.Row="0" Background="{StaticResource PanelHeaderBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel>
                <CheckBox x:Name="OnlyChanged" DockPanel.Dock="Right" Content="Only what differs from the defaults"
                          Margin="14,0,0,0" VerticalAlignment="Center" Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
                <ui:TextBox x:Name="Search" PlaceholderText="Search every setting: a name, a word from its explanation, a value"
                            TextChanged="OnFilterChanged" ClearButtonEnabled="True">
                    <ui:TextBox.Icon>
                        <ui:SymbolIcon Symbol="Search20" />
                    </ui:TextBox.Icon>
                </ui:TextBox>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The sections -->
            <ListBox x:Name="SectionList" Grid.Column="0" Background="{StaticResource PanelBrush}" BorderThickness="0"
                     Padding="6" SelectionChanged="OnSectionPicked" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <!-- A row: lit under the mouse, the one picked with the accent at its left; dim while searching -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Box" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0"
                                            CornerRadius="4" Padding="8,3" Margin="0,1">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Box" Property="Background" Value="{StaticResource RowHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Box" Property="Background" Value="{StaticResource SelectedRowBrush}" />
                                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Box" Property="Opacity" Value="0.45" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,3">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Badge}" Foreground="{StaticResource ChangedBrush}"
                                           FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource DimTextBrush}" FontSize="11"
                                       TextWrapping="Wrap" MaxHeight="30" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" />

            <!-- The settings -->
            <ScrollViewer x:Name="Scroller" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Rows" Margin="20,12,20,20" />
            </ScrollViewer>
        </Grid>

        <!-- What's unsaved, when the game takes it, and Save -->
        <Border Grid.Row="2" Background="{StaticResource PanelHeaderBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="14,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Open in a text editor" Click="OnOpenFile"
                            ToolTip="Opens rfa_mods.ini in the program Windows uses for .ini files" />
                    <Button x:Name="UndoButton" Content="Undo my changes" Click="OnUndo" IsEnabled="False"
                            ToolTip="Puts back what the file has, forgetting the changes you haven't saved" />
                    <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="Save" Click="OnSave"
                            IsEnabled="False" Margin="0" MinWidth="90" ToolTip="Writes your changes into rfa_mods.ini (Ctrl+S)" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="Status" TextWrapping="Wrap" />
                    <TextBlock x:Name="GameNote" Foreground="{StaticResource DimTextBrush}" FontSize="12" TextWrapping="Wrap"
                               Visibility="Collapsed" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
